FROM qwen3.6:35b-a3b-coding-nvfp4

# Tuned for agentic local development (opencode). num_ctx is the critical
# one: Ollama's default context silently truncates agent tool payloads.
# 21GB nvfp4 weights + 64k KV must fit the ~27GB Metal working set on
# 36GB — verify with `ollama ps` (100% GPU).
PARAMETER num_ctx 65536

# Qwen's recommended sampling for reasoning/coding (temp 0.6, top_p 0.95,
# top_k 20, min_p 0) rather than Gemma-style values — greedy decoding is
# explicitly discouraged for Qwen3-family models as it causes repetition
# loops in long agentic sessions.
PARAMETER temperature 0.6
PARAMETER top_p 0.95
PARAMETER top_k 20
PARAMETER min_p 0
