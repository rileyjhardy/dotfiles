FROM gemma4:26b-mlx

# The agentic-gemma choice: 26b-a4b is a 25.2B MoE with only 3.8B active
# params, so prefill and generation run in the same speed class as the
# qwen MoE — unlike the dense 31b, which prefills a 16k agent payload for
# ~3 minutes. num_ctx must be set or Ollama's default silently truncates
# agent tool payloads.
PARAMETER num_ctx 65536

# Google's recommended sampling for gemma4. Thinking models degrade under
# near-greedy decoding (hesitation, stalling at act-vs-narrate decision
# points), so don't lower temperature here — let the client override
# per-request if it wants more deterministic output.
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64
