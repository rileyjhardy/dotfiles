FROM gemma4:31b-mlx

# Tuned for agentic local development (opencode). The big one is num_ctx:
# Ollama defaults to a tiny context and silently truncates the agent's
# file/tool payloads. 19GB MLX weights + KV cache for 64k must fit inside
# the ~27GB Metal working set on 36GB — verify with `ollama ps` (100% GPU)
# and drop to 49152 if it spills.
PARAMETER num_ctx 65536

# Coding defaults in case the client does not override sampling. Lower than
# Gemma's chat default of 1.0 for more deterministic edits and tool calls,
# while keeping top_p/top_k at Gemma's recommended values.
PARAMETER temperature 0.3
PARAMETER top_p 0.95
PARAMETER top_k 64
