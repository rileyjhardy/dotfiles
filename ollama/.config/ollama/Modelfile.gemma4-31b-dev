FROM gemma4:31b-mlx

# Tuned for agentic local development (opencode). The big one is num_ctx:
# Ollama defaults to a tiny context and silently truncates the agent's
# file/tool payloads. 19GB MLX weights + KV cache for 64k must fit inside
# the ~27GB Metal working set on 36GB — verify with `ollama ps` (100% GPU)
# and drop to 49152 if it spills.
PARAMETER num_ctx 65536

# Google's recommended sampling for gemma4. Thinking models degrade under
# near-greedy decoding (hesitation, stalling at act-vs-narrate decision
# points), so don't lower temperature here — let the client override
# per-request if it wants more deterministic output.
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 64
