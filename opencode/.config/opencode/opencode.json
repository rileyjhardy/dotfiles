{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4-code",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:31b": {
          "name": "Gemma 4 31B",
          "tools": true
        },
        "gemma4:26b": {
          "name": "Gemma 4 26B",
          "tools": true
        },
        "gemma4:32k": {
          "name": "Gemma 4 12B (32k ctx)",
          "tools": true
        },
        "gemma4:12b-dev": {
          "name": "Gemma 4 12B (dev, 64k ctx)",
          "tools": true
        },
        "gemma4-code": {
          "name": "Gemma 4 26B (tuned)",
          "tools": true
        },
        "qwen3.6:35b-a3b-coding-nvfp4": {
          "name": "Qwen 3.6 35B A3B Coding (NVFP4)",
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "google-calendar": {
      "type": "local",
      "command": ["npx", "-y", "@cocal/google-calendar-mcp"],
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "/Users/rileyjhardy/.config/google-calendar-mcp/credentials.json"
      },
      "enabled": true
    }
  }
}
