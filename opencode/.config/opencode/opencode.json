{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6:35b-dev",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6:35b-dev": {
          "name": "Qwen 3.6 35B Coder (dev, 64k ctx)",
          "tools": true
        },
        "gemma4:26b-dev": {
          "name": "Gemma 4 26B MoE (dev, 64k ctx)",
          "tools": true
        },
        "gemma4:31b-dev": {
          "name": "Gemma 4 31B dense (deep, slow prefill)",
          "tools": true
        }
      }
    }
  },
  "mcp": {
    "google-calendar": {
      "type": "local",
      "command": ["npx", "-y", "@cocal/google-calendar-mcp"],
      "environment": {
        "GOOGLE_OAUTH_CREDENTIALS": "/Users/rileyjhardy/.config/google-calendar-mcp/credentials.json"
      },
      "enabled": true
    }
  }
}
